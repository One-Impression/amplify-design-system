{
  "name": "@amplify-ai/tokens-creator",
  "version": "2.0.3",
  "description": "Amplify Creator App design tokens — SDUI theme colors, typography, and component tokens",
  "main": "dist/tokens.js",
  "exports": {
    "./css": "./dist/variables.css",
    "./tailwind": "./dist/tailwind.css",
    "./dist/tailwind.css": "./dist/tailwind.css",
    "./json": "./dist/tokens.json",
    "./js": "./dist/tokens.js",
    "./react-native": "./dist/tokens.native.js",
    "./icons": "./dist/icons/manifest.json",
    "./icons/essentials": "./dist/icons/essentials.json",
    "./icons/types": "./dist/icons/manifest.d.ts",
    ".": "./dist/tokens.js"
  },
  "scripts": {
    "build": "node build.js && npx tsx scripts/build-icons.ts",
    "build:icons": "npx tsx scripts/build-icons.ts",
    "sync-check": "node scripts/sync-check.js"
  },
  "dependencies": {
    "@amplify-ai/tokens-foundation": "^2.0.1"
  },
  "devDependencies": {
    "style-dictionary": "^4.3.0"
  },
  "files": [
    "dist/",
    "tokens/",
    "scripts/",
    "icons/"
  ]
}
